<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Product>raidTimeline.Logic</Product>
    <Company />
	<PackageId>raidTimeline.Logic</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="templateStatistics.html" />
    <None Remove="templateTimeline.html" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Mechanics\mechanics.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="templateStatistics.html" Pack="true">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="templateTimeline.html" Pack="true">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="OneOf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\raidTimeline.Models\raidTimeline.Models.csproj" />
  </ItemGroup>

</Project>
